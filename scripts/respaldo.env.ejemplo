# Copiar este archivo como .respaldo.env en la carpeta scripts/ y poner valores propios:
#   cp scripts/respaldo.env.ejemplo scripts/.respaldo.env
#   chmod 600 scripts/.respaldo.env
# NO subir .respaldo.env a GitHub (ya está en el .gitignore).
# Usar valores SIN comillas simples (') ni espacios. Las contraseñas de usuario
# deben cumplir la política: 8+ caracteres, dígito, mayúscula, minúscula y símbolo.

# Contraseña de root de MariaDB (la usan docker-compose, instalar.sh y respaldar.sh)
DB_PASS=CAMBIAR_root_Pass#1

# Contraseñas de los usuarios de la base (se aplican en sql/07_seguridad.sql)
PASS_LECTOR=CAMBIAR_Lector#1
PASS_RECEPCION=CAMBIAR_Recepcion#1
PASS_GESTOR=CAMBIAR_Gestor#1

# Llave de cifrado AES de las observaciones médicas y PIN de práctica de los pacientes
LLAVE_AES=CAMBIAR_llave_AES_larga
PIN_DEMO=CAMBIAR_Pin#1

# Opcional (regla 3-2-1): carpeta de una segunda ubicación donde copiar cada respaldo
# (otro disco, USB o carpeta sincronizada con la nube). Dejar vacío si no se usa.
DIR_COPIA=
